{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    { "src": "/obrigado/?", "dest": "/obrigado/index.html" },
    { "src": "/privacidade/?", "dest": "/privacidade/index.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/404.html", "status": 404 }
  ]
}
